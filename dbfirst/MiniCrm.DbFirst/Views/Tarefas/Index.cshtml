@model IEnumerable<MiniCrm.DbFirst.Models.Tarefa>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Concluida)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ConcluidaEm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CriadoEm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataVencimento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descricao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Titulo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdClienteNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdOportunidadeNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdUsuarioNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Concluida)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ConcluidaEm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CriadoEm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataVencimento)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Descricao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Titulo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdClienteNavigation.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdOportunidadeNavigation.Etapa)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdUsuarioNavigation.Email)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdTarefa">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdTarefa">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdTarefa">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
