@model IEnumerable<MiniCrm.DbFirst.Models.Usuario>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Ativo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.AtualizadoEm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.BloqueadoAte)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CriadoEm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Perfil)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SenhaHash)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TentativasLogin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrocarSenha)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.UltimoAcesso)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdGerenteNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Ativo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AtualizadoEm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.BloqueadoAte)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CriadoEm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Perfil)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SenhaHash)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TentativasLogin)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TrocarSenha)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.UltimoAcesso)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdGerenteNavigation.Email)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdUsuario">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdUsuario">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdUsuario">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
