@model IEnumerable<MiniCrm.DbFirst.Models.TokenRecuperacao>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CodigoHash)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CriadoEm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ExpiraEm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Usado)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdUsuarioNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CodigoHash)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CriadoEm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ExpiraEm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Usado)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdUsuarioNavigation.Email)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdToken">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdToken">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdToken">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
