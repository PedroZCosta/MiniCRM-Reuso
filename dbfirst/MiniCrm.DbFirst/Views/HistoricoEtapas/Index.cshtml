@model IEnumerable<MiniCrm.DbFirst.Models.HistoricoEtapa>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.AlteradoEm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EtapaAnterior)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EtapaNova)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdOportunidadeNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdUsuarioNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.AlteradoEm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EtapaAnterior)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EtapaNova)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdOportunidadeNavigation.Etapa)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdUsuarioNavigation.Email)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdHistorico">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdHistorico">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdHistorico">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
