@model IEnumerable<MiniCrm.DbFirst.Models.Interacao>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.CriadoEm)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataInteracao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Observacoes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tipo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdClienteNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.IdUsuarioNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.CriadoEm)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataInteracao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Observacoes)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tipo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdClienteNavigation.Email)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.IdUsuarioNavigation.Email)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.IdInteracao">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.IdInteracao">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.IdInteracao">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
